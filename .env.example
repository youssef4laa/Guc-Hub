# Copy to .env.local (gitignored) for local development.
# Every var here MUST be prefixed EXPO_PUBLIC_ to be readable at runtime (Expo only
# inlines that prefix into the JS bundle) — see https://docs.expo.dev/guides/environment-variables/
#
# Reserved blocks below (see docs/PARALLEL_WORK.md): add a new var to your own
# track's block, never to another track's. Keep at least 3 blank lines between
# blocks so parallel edits in different blocks merge without a conflict.

# ===== SHARED =====

# "mock" runs the whole app on fake data (Try Demo does the same thing at runtime).
# Leave unset (or "live") to hit the real portal once a LoginStrategy is implemented.
EXPO_PUBLIC_MODE=mock

# Comma-separated extra hosts allowed in dev builds only (e.g. a local fixture
# server or an HTTP debugging proxy). Never read in production builds. Each
# feature's own hosts.ts (see core/http/hosts.generated.ts) is the normal way to
# allow a host — this is only for ad hoc local debugging.
EXPO_PUBLIC_HTTP_DEV_ALLOWLIST=



# ===== TRACK A (Portal) =====

# Read by src/features/{schedule,grades,transcript,cms,exams,attendance,staff,
# evaluations}/hosts.ts. Unknown until DISCOVERY Spike 1/3 resolve — this is a
# placeholder, not a confirmed real host.
EXPO_PUBLIC_GUC_PORTAL_HOST=portal.example-guc.invalid

# Which LoginStrategy src/core/portal/selectLoginStrategy.ts picks: mock | ntlm | form.
# ntlm/form are stubs until DISCOVERY Spike 1 resolves.
EXPO_PUBLIC_PORTAL_AUTH_STRATEGY=mock



# ===== TRACK B (Mail & Experience) =====

# Read by src/features/mail/hosts.ts. Unknown until DISCOVERY Spike 2 resolves
# (also depends on whether the mail login differs from the portal login) — this
# is a placeholder, not a confirmed real host.
EXPO_PUBLIC_GUC_MAIL_HOST=mail.example-guc.invalid
