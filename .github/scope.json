      "branchPrefixes": ["portal/"],
      "owner": "@youssef4laa",
      "allow": [
        "src/features/schedule/**",
        "src/features/grades/**",
        "src/features/transcript/**",
        "src/features/cms/**",
        "src/features/exams/**",
        "src/features/attendance/**",
        "src/features/staff/**",
        "src/features/evaluations/**",
        "app/(tabs)/schedule.tsx",
        "app/(tabs)/grades.tsx",
        "app/(tabs)/transcript.tsx",
        "app/(tabs)/cms.tsx",
        "app/(tabs)/exams.tsx",
        "app/(tabs)/attendance.tsx",
        "app/(tabs)/staff.tsx",
        "app/(tabs)/evaluations.tsx",
        "fixtures/schedule/**",
        "fixtures/grades/**",
        "fixtures/transcript/**",
        "fixtures/cms/**",
        "fixtures/exams/**",
        "fixtures/attendance/**",
        "fixtures/staff/**",
        "fixtures/evaluations/**",
        "src/core/portal/**",
        "src/core/http/**",
        "config/plugins.portal.js",
        "docs/discovery/spike-1*.md",
        "docs/discovery/spike-3*.md",
        "docs/discovery/spike-4*.md",
        "docs/discovery/spike-6*.md",
        "docs/roadmap/track-a.md",
        "docs/adr/A-*"
