        "src/features/mail/**",
        "src/features/flappy/**",
        "src/features/settings/**",
        "app/(tabs)/mail.tsx",
        "app/(tabs)/flappy.tsx",
        "app/(tabs)/settings.tsx",
        "app/(tabs)/more.tsx",
        "fixtures/mail/**",
        "fixtures/flappy/**",
        "src/core/ui/**",
        "src/core/theme/**",
        "src/core/notifications/**",
        "native/widgets/**",
        "config/plugins.mail.js",
        "docs/discovery/spike-2*.md",
        "docs/discovery/spike-5*.md",
        "docs/discovery/spike-widgets*.md",
        "docs/roadmap/track-b.md",
        "docs/adr/B-*"
      ]
