{
  "name": "guc-hub",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/query-async-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "expo": "~57.0.24",
    "expo-background-task": "~57.0.19",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.19",
    "i18next": "^26.4.2",
    "node-html-parser": "^9.0.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "predev": "node tools/gen-registry.js",
    "start": "node tools/gen-registry.js && expo start --dev-client",
    "android": "node tools/gen-registry.js && expo start --dev-client --android",
    "ios": "node tools/gen-registry.js && expo start --dev-client --ios",
    "web": "node tools/gen-registry.js && expo start --web",
    "pretypecheck": "node tools/gen-registry.js",
    "typecheck": "tsc --noEmit",
    "prelint": "node tools/gen-registry.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "pretest": "node tools/gen-registry.js",
    "test": "jest",
    "e2e": "maestro test .maestro",
    "gen:feature": "node tools/gen-feature.js",
    "gen:registry": "node tools/gen-registry.js",
    "sanitize-fixture": "node tools/sanitize-fixture.js",
    "check-fixtures": "node tools/check-fixtures.js",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/fixtures/"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
